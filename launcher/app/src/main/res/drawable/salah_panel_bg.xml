<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Dark translucent base (75% opacity) ensuring high contrast and 10-foot TV readability over any wallpaper -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#BF080D17" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <!-- Frosted glass sheen and 1dp crisp translucent border matching dock glass aesthetics -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#2BFFFFFF"
                android:endColor="#0DFFFFFF" />
            <stroke
                android:width="1dp"
                android:color="#38FFFFFF" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</layer-list>
